# ============================================
# Vibe Video Environment Configuration
# ============================================
# Copy to .env and fill in your values:
#   cp example.env .env
#
# WARNING: Never commit .env to version control.
# ============================================

# ------------------------------------------
# Required: API Keys
# ------------------------------------------

# Google API key (required for leader + all agents)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ------------------------------------------
# Optional: Web Research (Researcher agent)
# ------------------------------------------
# Parallel API key for web search + content extraction.
# When set, the Researcher agent joins the team. When unset, the leader
# proceeds from model knowledge only.
# Get from: https://parallel.ai

# PARALLEL_API_KEY=

# ------------------------------------------
# Optional: Private repo access (CodeExplorer agent)
# ------------------------------------------
# Fine-grained GitHub PAT with Contents: Read access on the repos you want
# CodeExplorer to clone. Public repos clone without this.

# GITHUB_ACCESS_TOKEN=

# ------------------------------------------
# Optional: Animator behavior
# ------------------------------------------
# How many times Animator retries a failed render before giving up.

# MAX_RENDER_RETRIES=3

# ------------------------------------------
# Optional: Security (production only)
# ------------------------------------------
# RBAC is enabled automatically in production (RUNTIME_ENV=prd).
# Generate a key pair from os.agno.com → Settings.

# JWT_VERIFICATION_KEY=

# ------------------------------------------
# Optional: Database
# ------------------------------------------
# Defaults below work for local development with docker compose.

# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_HOST=localhost
# DB_PORT=5432
